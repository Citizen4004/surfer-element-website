---
import { withBase } from "../lib/url";
import { formatCheckedDate, formatScore } from "../lib/format";
import type { House } from '../data/houses';
import { bookingSearchUrl } from '../data/houses';
import PhotoPlaceholder from './PhotoPlaceholder.astro';
interface Props {
  house: House;
  /** Render the (initially empty) "Closest match" row at the top. Used by
   * the fit-check results so every card has the same row count and the
   * subgrid keeps photos, scores and lists aligned across all three. */
  matchSlot?: boolean;
}
const { house, matchSlot } = Astro.props as Props;
const houseUrl = withBase(`/houses/${house.slug}/`);
const reviewsUrl = bookingSearchUrl(house.name);
const checked = formatCheckedDate(house.checkedDate);
// DESIGN.md §7.1 fixed anatomy. Each top-level child below is one grid row
// (8 rows, 9 with matchSlot) — keep that count identical for every house.
---
<article class="house-card" data-slug={house.slug} style={`--house-accent: var(${house.accentVar})`}>
  {matchSlot && <div class="house-card__match"></div>}

  <div class="house-card__photo">
    <PhotoPlaceholder name={house.name} />
  </div>

  <div class="house-card__name-block">
    <div class="house-card__name">
      <span class="house-dot" style={`background: var(${house.accentVar})`} aria-hidden="true"></span>
      <h3>{house.name}</h3>
    </div>
    <p class="house-card__location">Tamraght, Morocco</p>
  </div>

  <div class="house-card__evidence">
    <p class="house-card__score">
      <span class="house-card__score-num">{formatScore(house.score)}</span>
      <span class="house-card__score-label">/ 10</span>
    </p>
    <p class="house-card__reviews">{house.reviews} reviews on Booking.com</p>
    <p class="house-card__meta">Checked {checked} &middot; <a href={reviewsUrl} target="_blank" rel="noopener noreferrer nofollow">See the reviews on Booking.com &#8599;<span class="visually-hidden"> (opens in a new tab)</span></a></p>
  </div>

  <div class="subscores">
    {house.subscores.map((s) => (
      <div class="subscore__row">
        <span class="subscore__label">{s.label}</span>
        <span class="subscore__num">{formatScore(s.value)}</span>
        <span class="subscore__bar" aria-hidden="true"><span style={`width:${(s.value/10)*100}%`}></span></span>
      </div>
    ))}
  </div>

  <div>
    <p class="guest-theme" style={`border-color: var(${house.accentVar})`}>{house.theme}</p>
    <p class="guest-theme__meta">Summarised from Booking.com guest reviews, not quoted verbatim &middot; checked {checked} &middot; <a href={reviewsUrl} target="_blank" rel="noopener noreferrer nofollow">Read them on Booking.com &#8599;<span class="visually-hidden"> (opens in a new tab)</span></a></p>
  </div>

  <div class="fit-lists">
    <div class="fit-list">
      <h4>Good fit if</h4>
      <ul>
        {house.goodFitIf.map((item) => (
          <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg> {item}</li>
        ))}
      </ul>
    </div>
    <div class="fit-list">
      <h4>Not a fit if</h4>
      <ul>
        {house.notAFitIf.map((item) => (
          <li><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14"/></svg> {item}</li>
        ))}
      </ul>
    </div>
  </div>

  <p class="house-card__price">Same price at all three houses. <a href={withBase("/price-lock/")}>How pricing and the deposit work &rarr;</a></p>

  <a class="btn btn-secondary" href={houseUrl}>See {house.name} &rarr;</a>
</article>
