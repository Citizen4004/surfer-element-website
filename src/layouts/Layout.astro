---
// Self-hosted fonts (DESIGN.md §4): Astro bundles these WOFF2 files into
// the build, so no request ever goes to Google Fonts.
import '@fontsource-variable/source-serif-4/opsz.css';
import '@fontsource-variable/source-sans-3/wght.css';
import '../styles/global.css';
import DisclosureNote from '../components/DisclosureNote.astro';
import { withBase, stripBase } from '../lib/url';

interface Props {
  title: string;
  description: string;
  navLabel?: string;
  /** JSON-LD graph node(s) specific to this page (Service/LodgingBusiness on
   * house + compare pages, FAQPage on the FAQ page). Merged into the
   * sitewide Organization/WebSite/WebPage graph below. Never add
   * aggregateRating here — Booking.com scores stay visible text only, per
   * entity-brief.md. */
  pageSchema?: Record<string, unknown>[];
}
const { title, description, navLabel, pageSchema } = Astro.props as Props;

// Astro.url.pathname already includes `base` when one is configured, so
// strip it back off here to get the "logical" app path — the lang-switch
// links below rebuild the URL with withBase(), and prefixing twice would
// break them under the subpath deployment.
const rawPath = Astro.url.pathname;
const logicalPath = stripBase(rawPath);

// Sitewide entity schema (entity/entity-brief.md "Starting JSON-LD"). One
// Organization @id and one WebSite @id for the whole site, referenced by
// every page/locale rather than one node per locale. No address/geo/hours
// yet (the agency's own real address isn't confirmed — see config.md), and
// sameAs stays [] until a real, active profile exists. ContactPoint
// availableLanguage is the real staff languages (EN/FR), not the site's six
// locales — see entity-brief.md's fix for this exact mix-up.
const canonicalUrl = new URL(rawPath, Astro.site).toString();
// Only English pages are actually live right now (see Layout's language
// switcher below and sitemap.xml.ts) — the WebSite's inLanguage reflects
// reality today rather than the six-locale end state, so it grows as each
// translation actually ships instead of claiming pages that don't exist yet.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'TravelAgency',
      '@id': 'https://surferelement.com/#organization',
      name: 'Surfer Element',
      url: 'https://surferelement.com/',
      logo: {
        '@type': 'ImageObject',
        '@id': 'https://surferelement.com/#logo',
        url: new URL(withBase('/logo/mark.svg'), Astro.site).toString(),
        width: '512',
        height: '512',
      },
      description:
        "Surfer Element is a surf-camp booking agency in Tamraght, Morocco. We work with a small number of named, independent surf houses and help you pick the one whose atmosphere suits you. The site is available in English, German, French, Spanish, Italian and Dutch; we speak with you directly in English or French. We don't own any of the houses.",
      disambiguatingDescription: 'Surf-camp booking agency in Tamraght, Morocco.',
      email: 'contact@surferelement.com',
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'customer service',
        availableLanguage: ['en', 'fr'],
        email: 'contact@surferelement.com',
      },
      areaServed: { '@type': 'Place', name: 'Tamraght, Morocco' },
      sameAs: [],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://surferelement.com/#website',
      url: 'https://surferelement.com/',
      name: 'Surfer Element',
      inLanguage: ['en'],
      publisher: { '@id': 'https://surferelement.com/#organization' },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: title,
      description,
      isPartOf: { '@id': 'https://surferelement.com/#website' },
      inLanguage: 'en',
      datePublished: '2026-11-03',
      dateModified: '2026-11-03',
    },
    ...(pageSchema ?? []),
  ],
};

const ogImage = new URL(withBase('/og/og-image.png'), Astro.site).toString();

const nav = [
  { href: '/compare/', label: 'Compare' },
  { href: '/fit-check/', label: 'Fit check' },
  { href: '/price-lock/', label: 'Price lock' },
  { href: '/guide/', label: 'Tamraght guide' },
  { href: '/about/', label: 'About' },
];

// Only English is live (see sitemap.xml.ts / robots.txt.ts / this file's
// WebSite.inLanguage). The other five are the planned end state (DESIGN.md
// §5), shown as non-clickable "coming soon" entries below rather than as
// <a href> links, so this switcher never points at a page that 404s — it
// was doing exactly that on every page before this fix (/de/..., /fr/...,
// etc. all returned 404 with no translated content behind them).
const locales = [
  { code: 'en', label: 'English', live: true },
  { code: 'de', label: 'Deutsch', live: false },
  { code: 'fr', label: 'Français', live: false },
  { code: 'es', label: 'Español', live: false },
  { code: 'it', label: 'Italiano', live: false },
  { code: 'nl', label: 'Nederlands', live: false },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Surfer Element" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Surfer Element — three surf houses in Tamraght, one way to book" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="canonical" href={canonicalUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <header class="site-header" id="site-header">
      <div class="container site-header__bar">
        <a class="site-header__logo" href={withBase('/')}>
          {/* Inline copy of design/logo/surferelement-mark.svg (same paths),
              coloured with tokens so the tag flips to the light version in
              dark mode per DESIGN.md §10. Decorative: the wordmark is the
              link text. */}
          <svg viewBox="0 0 64 64" width="28" height="28" aria-hidden="true" focusable="false">
            <path class="logo-tag" d="M20 14 H53 A4 4 0 0 1 57 18 V46 A4 4 0 0 1 53 50 H20 L7 37 V27 Z"/>
            <circle class="logo-eyelet" cx="16" cy="32" r="3.4"/>
            <text class="logo-monogram" x="38.5" y="40.5" text-anchor="middle" font-size="23" letter-spacing="-0.3">Se</text>
          </svg>
          <span class="site-header__logo-word">Surfer Element</span>
        </a>
        <nav class="site-nav" aria-label="Main">
          {nav.map((item) => (
            <a href={withBase(item.href)} aria-current={navLabel === item.label ? 'page' : undefined}>{item.label}</a>
          ))}
        </nav>
        <div class="site-header__actions">
          <a class="btn-quiet" href={withBase('/contact/')}>Ask us</a>
          <div class="lang-switch" id="lang-switch">
            <button type="button" class="lang-switch__button" id="lang-switch-button" aria-expanded="false" aria-controls="lang-switch-menu" aria-label="Language: English">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15 15 0 010 20 15 15 0 010-20z"/></svg>
              EN
            </button>
            <div class="lang-switch__menu" id="lang-switch-menu">
              {locales.map((l) => (
                l.live
                  ? <a href={withBase(logicalPath)} aria-current="true">{l.label}</a>
                  : <span class="lang-switch__pending" aria-disabled="true">{l.label} <small>(coming soon)</small></span>
              ))}
            </div>
          </div>
          <button type="button" class="nav-toggle" id="nav-toggle" aria-expanded="false" aria-controls="mobile-nav" aria-label="Menu">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 12h18M3 6h18M3 18h18"/></svg>
          </button>
        </div>
      </div>
      <nav class="mobile-nav container" id="mobile-nav" aria-label="Main, mobile">
        {nav.map((item) => (<a href={withBase(item.href)}>{item.label}</a>))}
        <a href={withBase('/contact/')}>Ask us</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div style="margin-bottom: var(--space-6)"><DisclosureNote /></div>
        <div class="site-footer__grid">
          <div>
            <h2 class="site-footer__heading">The houses</h2>
            <ul>
              <li><a href={withBase('/houses/surfshub-tamraght/')}>SurfsHUB Tamraght</a></li>
              <li><a href={withBase('/houses/cactus-surf-skate-house/')}>Cactus Surf &amp; Skate House</a></li>
              <li><a href={withBase('/houses/hakuna-matata/')}>Hakuna Matata Guest House</a></li>
            </ul>
          </div>
          <div>
            <h2 class="site-footer__heading">Surfer Element</h2>
            <ul>
              <li><a href={withBase('/compare/')}>Compare</a></li>
              <li><a href={withBase('/fit-check/')}>Fit check</a></li>
              <li><a href={withBase('/price-lock/')}>Price lock</a></li>
              <li><a href={withBase('/about/')}>About</a></li>
              <li><a href={withBase('/faq/')}>FAQ</a></li>
              <li><a href={withBase('/contact/')}>Contact</a></li>
            </ul>
          </div>
          <div>
            <h2 class="site-footer__heading">Contact</h2>
            <ul>
              <li><a href="mailto:contact@surferelement.com">contact@surferelement.com</a></li>
              <li>Based in Tamraght, Morocco</li>
            </ul>
          </div>
        </div>
        <div class="site-footer__meta">
          <p>Booking.com scores checked on 3 Nov 2026. &copy; Surfer Element.</p>
        </div>
      </div>
    </footer>

    <script>
      const header = document.getElementById('site-header');
      window.addEventListener('scroll', () => {
        header?.classList.toggle('is-scrolled', window.scrollY > 4);
      }, { passive: true });

      const navToggle = document.getElementById('nav-toggle');
      const mobileNav = document.getElementById('mobile-nav');
      navToggle?.addEventListener('click', () => {
        const open = mobileNav?.classList.toggle('is-open');
        navToggle.setAttribute('aria-expanded', String(!!open));
      });

      const langButton = document.getElementById('lang-switch-button');
      const langMenu = document.getElementById('lang-switch-menu');
      langButton?.addEventListener('click', (e) => {
        e.stopPropagation();
        const open = langMenu?.classList.toggle('is-open');
        langButton.setAttribute('aria-expanded', String(!!open));
      });
      const closeLang = () => {
        langMenu?.classList.remove('is-open');
        langButton?.setAttribute('aria-expanded', 'false');
      };
      document.addEventListener('click', closeLang);
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && langMenu?.classList.contains('is-open')) { closeLang(); langButton?.focus(); }
      });
    </script>
  </body>
</html>
